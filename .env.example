# Settings for the RaceRoom container. Copy to .env (see README, Setup). After a change: docker compose up -d

# Which instances to start automatically when the container (re)starts:
#   all   = every instance that exists (default)
#   last  = only those that were running before the restart
#   none  = none
#   or a comma-separated list of instance IDs, e.g. 123456,234567
RR_AUTOSTART=all

# Seconds to wait before the automatic start. Do not go below 45: right after an unclean restart the
# server hands out ports 60003/60005 instead of 60000/60002.
#RR_AUTOSTART_DELAY=45

# Serve Prometheus metrics (players, session, best laps) on this port, see README, Metrics.
#RR_METRICS_PORT=9127
#RR_METRICS_INTERVAL=15

# MAC address of the container. The server encrypts its settings with a key derived from it, so it
# must never change after the server has been registered. Setup step 2 in the README appends a
# random one to .env.
#RR_MAC_ADDRESS=02:xx:xx:xx:xx:xx
