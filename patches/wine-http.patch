+/* The connection sockets are non-blocking. Send everything, waiting for the peer if necessary,
+ * instead of dropping the connection (or silently the rest of the data) when the send buffer is full. */
+static int send_all(SOCKET socket, const char *buffer, int len)
+{
+    while (len > 0)
+    {
+        int ret = send(socket, buffer, len, 0);
+
+        if (ret < 0)
+        {
+            struct timeval timeout = {30, 0};
+            fd_set writefds;
+
+            if (WSAGetLastError() != WSAEWOULDBLOCK)
+                return -1;
+            FD_ZERO(&writefds);
+            FD_SET(socket, &writefds);
+            if (select(0, NULL, &writefds, NULL, &timeout) <= 0)
+            {
+                WSASetLastError(WSAETIMEDOUT);
+                return -1;
+            }
+            continue;
+        }
+        buffer += ret;
+        len -= ret;
+    }
+    return 0;
+}
